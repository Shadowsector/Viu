# Секреты (токены) — не коммитить
.env

# Локальные Ollama Modelfile / jailbreak — правки не перетираются обновлением Viu
ollama/Modelfile.viu-*
!ollama/Modelfile.viu-*.example
ollama/_SYSTEM_SNIPPET.txt

# Служебные данные агента (память, планы, логи, уроки)
.viu/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Пользовательские инструменты, созданные агентом на лету
viu/tools/custom/*.py
!viu/tools/custom/__init__.py
U:/
