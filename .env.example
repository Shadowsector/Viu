# Viu — настройки (скопировано из .env.example при первом запуске)
# Правь этот файл и перезапусти Viu.

# --- LLM (Ollama / OpenAI) ---
VIU_PROVIDER=openai
VIU_BASE_URL=http://localhost:11434/v1
VIU_API_KEY=ollama
# Рекомендуемый набор (см. docs/LLM_ROLES.md):
#   reflect = Cydonia 24B, work = Qwen 32B wrap, code = coder 14B
# Сборка обёрток: create_viu_ollama_models.bat
# Чистка тяжёлых: cleanup_ollama_models.bat
VIU_MODEL=viu-cydonia
VIU_MODEL_REFLECT=viu-cydonia
VIU_MODEL_WORK=viu-qwen32
VIU_MODEL_CODE=qwen2.5-coder:14b
# Важно: модель в окне Ollama на Viu НЕ влияет — только эти переменные.
# Обёртки viu-* = NSFW SYSTEM. Не ставь coder в REFLECT.
# Сборка: create_viu_ollama_models.bat
# GDD / сюжет / квесты (Command R) — раскомментируй вместо cydonia выше:
# VIU_MODEL_REFLECT=viu-command-r
# Обычный чат / ERP: viu-cydonia | лит. NSFW: viu-magnum
# Перезапуск Вью обязателен. Тег: create_viu_ollama_models.bat
# llava — vision: глаза Unity, creature_describe, comfy_vision_review (MoCap QA)
# ollama pull llava
# После Comfy MoCap: кадр из mp4 → llava → отсев битых дублей до Telegram. 0 = выкл.
VIU_COMFY_VISION=1
# Таймаут ответа LLM (сек). 1200 = 20 минут — Cydonia/Command R на CPU/свопе.
VIU_LLM_TIMEOUT=1200
VIU_REFLECT_TEMPERATURE=0.88
# Reflect: bare-пайплайн, без пост-цензуры.
# По умолчанию Viu шлёт system с REFLECT_VOICE (жизнь/характер).
# VIU_REFLECT_NO_SYSTEM=1 — только Modelfile (отладка; голос из reflect не едет).
VIU_REFLECT_FILTERED=0
# VIU_REFLECT_NO_SYSTEM=1
# История = только текущая сессия GUI/Telegram (story_memory НЕ подмешивается).
# Отладка — одиночный запрос без истории:
# VIU_REFLECT_NO_HISTORY=1
# Вернуть старое: story_memory в начало чата:
# VIU_REFLECT_STORY_HISTORY=1
# Дамп запроса в .viu/logs/reflect_last_request.json:
# VIU_REFLECT_DUMP=1

# Comfy уступает GPU, пока Вью думает. Soft по умолчанию (не рвёт MoCap).
VIU_COMFY_YIELD_ON_CHAT=1
# 1 = жёсткий interrupt текущего job при чате (старое поведение).
VIU_COMFY_YIELD_INTERRUPT=0
VIU_COMFY_YIELD_FREE_VRAM=1
# Окно консоли Comfy: по умолчанию выкл (пустое чёрное окно было багом).
# Прогресс — .viu/logs/comfy_launch.log и Студия Comfy.
VIU_COMFY_SHOW_CONSOLE=0
# Открыть браузер :8188 после успешного ensure/restart.
VIU_COMFY_OPEN_BROWSER=1
# Comfy MoCap: nsfw = только touch_self/shower/bath (sit/walk — Mixamo). barn = цикл сарая.
VIU_COMFY_FOCUS=nsfw
# Фоновая lab каждые N минут в режиме «меня нет»; 0 = выкл.
VIU_LAB_INTERVAL_MIN=5
# Держать модель в VRAM после ответа: 5m | 0 (сразу выгрузить) | -1
VIU_OLLAMA_KEEP_ALIVE=5m
# Длина контекста для запросов Viu → Ollama (токены).
VIU_OLLAMA_NUM_CTX=16384
# Длинные GDD-ответы в reflect (сценарии, квесты) — иначе JSON обрывается на середине
VIU_OLLAMA_NUM_PREDICT=4096

# Лимит VRAM для Ollama (LLM). 10 GB — было 6. После смены: перезапуск Ollama из трея.
VIU_LAB_VRAM_GB=10

# --- Unity / Anabarra ---
VIU_UNITY_PROJECT=U:\Anabarra\Unity\Anabarra

# --- GitHub: handoff для Cursor + обновления ---
# Формат: Shadowsector/Viu (не URL). Classic PAT scopes: repo + gist
# Public repo OK — для записи нужен scope repo (или public_repo), не private.
VIU_GITHUB_TOKEN=
VIU_GITHUB_REPO=Shadowsector/Viu
# Ветка для handoff (пусто = default репозитория или cursor/viu-agent-core-65c2)
# VIU_HANDOFF_BRANCH=cursor/viu-agent-core-65c2

# --- Cascadeur (анимации, опционально) ---
# VIU_CASCADEUR_EXE=U:\Cascadeur\App\Cascadeur\cascadeur.exe
# VIU_BLENDER_EXE=C:\Program Files (x86)\Steam\steamapps\common\Blender\blender.exe

# --- Telegram ---
VIU_TELEGRAM_TOKEN=
VIU_TELEGRAM_ENABLED=1
# Только этот Telegram user id может писать боту (дефолт в коде: 103833998).
# VIU_TELEGRAM_OWNER_IDS=103833998
# VIU_TELEGRAM_CHAT_ID=103833998

# --- Обновления Viu (кнопка «Обновить Вью» и авто) ---
# Ветка на GitHub, откуда тянем zip/git. Менять не нужно — только «Обновить Вью».
VIU_UPDATE_BRANCH=cursor/viu-agent-core-65c2
# Проверка GitHub раз в N минут; 0 = выкл. При новой версии — скачает и перезапустит.
VIU_UPDATE_INTERVAL_MIN=60
# 1 = авто при старте и по таймеру; 0 = только кнопка «Обновить Вью»
VIU_AUTO_UPDATE=1

# --- Таймер и тишина ---
VIU_HEARTBEAT_MIN=0
VIU_QUIET_HOURS=0-7
